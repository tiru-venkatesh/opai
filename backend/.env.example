# ---- LLM (Claude first, Groq as automatic fallback) -------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys. With this set, KARNA runs on Claude.
ANTHROPIC_API_KEY=
# auto (default) = Claude if ANTHROPIC_API_KEY is set, else Groq. Or force: anthropic | groq
# KARNA_PROVIDER=auto
# Model tiers (defaults shown). fast = routing/extraction, balanced = answers/RAG/chat, deep = opt-in hardest tasks.
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_AGENT_MODEL=claude-sonnet-5-5
# CLAUDE_DEEP_MODEL=claude-opus-5-5
# If Claude errors/overloads, retry the same call on Groq (needs GROQ_API_KEY). off = fail instead.
# KARNA_FALLBACK=on
# GENERAL_MAX_TOKENS=2500

# Copy this file to ".env" in the same folder (backend/.env) and fill in real values.
# python-dotenv loads it automatically on startup (main.py calls load_dotenv()).

# Required for KARNA chat, Resume Lab scoring/"ask this resume", and study-plan text.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional: defaults to a local SQLite file if not set.
# For Render / production, point this at a Postgres connection string instead,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./opa.db

# Local-only no-login development mode. The backend honors this only for
# requests arriving from this computer (loopback); keep it off in deployments.
# OPAI_LOCAL_AUTH_BYPASS=false

# Optional: force the resume/RAG embedder. auto (default) tries fastembed, falls
# back to a hashed embedder if that's unavailable. Set to "hash" to force the
# lightweight fallback, or "fastembed" to require the real model.
# RAG_EMBEDDER=auto

# Typed routing: Jev first -> Groq structured fallback -> deterministic fallback.
# Jev is provider-agnostic here because its exact production endpoint/contract
# must come from your TypeSafe account.
JEV_ENABLED=false
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_SECONDS=8

# Groq model roles. The router uses a smaller structured-output model;
# KARNA tool calling can use the agent model.
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Never enable this in production.
ENABLE_DEV_SEED=false
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GENERAL_CHAT_PER_MIN=20

# Knowledge uploads (rag_api.py). Defaults shown.
# RAG_MAX_FILE_MB=10
# Minimum relevance for a passage to be used. Tune against your own documents:
# RAG_MIN_SCORE_FASTEMBED=0.30
# RAG_MIN_SCORE_HASH=0.12

# ---- Model picker (agent/model_catalog.py) ----
# Optional Hugging Face models (General mode only by default). Needs a HF token with Inference Providers access.
# HUGGINGFACE_API_KEY=
# JSON list; verify every model id on its Hugging Face page first, provider availability changes:
# KARNA_HF_MODELS=[{"key":"hf-llama-3-3-70b","label":"Llama 3.3 70B (Hugging Face)","model_id":"meta-llama/Llama-3.3-70B-Instruct"}]
# KARNA_GROQ_MODELS=[{"key":"groq-gpt-oss-20b","label":"GPT-OSS 20B (Groq)","model_id":"openai/gpt-oss-20b"}]
# Let Hugging Face models see Workspace data (documents, profile)? Off by default: it reaches third-party providers.
# KARNA_HF_WORKSPACE=off
# Per user per day, by cost tier. Defaults shown.
# KARNA_DAILY_CAPS=fast:300,balanced:150,deep:20,open:80
# HF_TIMEOUT=60
