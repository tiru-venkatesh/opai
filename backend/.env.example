# ---- KARNA multi-provider AI (all keys are backend-only; never commit real values) -------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
KARNA_DEFAULT_MODE=auto
KARNA_ENABLE_FALLBACK=true
KARNA_ENABLE_PAID_MODELS=false
KARNA_ENABLE_MEMORY=true
KARNA_ENABLE_RAG=true
KARNA_GEMINI_WORKSPACE_ALLOWED=false
KARNA_ANTHROPIC_WORKSPACE_ALLOWED=false
KARNA_USER_RPM=30
KARNA_CONTEXT_MAX_CHARS=48000
KARNA_PROVIDER_MAX_RETRIES=1
GROQ_TIMEOUT=45
GEMINI_TIMEOUT=45
OPENROUTER_TIMEOUT=45
# Optional account-specific provider quotas. Leave empty unless you have verified limits for your provider plan.
# Example shape: {"groq":{"requests_per_minute":60,"tokens_per_day":1000000}}
KARNA_PROVIDER_LIMITS_JSON={}
# Allow OpenRouter image requests only after configuring a vision-capable model.
KARNA_OPENROUTER_VISION_CAPABLE=false
# Optional current rates for aggregate cost estimates; leave empty to avoid invented estimates.
# Format: {"groq/openai/gpt-oss-120b":{"input_per_million":0.15,"output_per_million":0.60}}
KARNA_PRICE_PER_1M_JSON={}
# Legacy paid provider is disabled unless KARNA_ENABLE_PAID_MODELS=true.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=60
GENERAL_MAX_TOKENS=2500

# Copy this file to ".env" in the same folder (backend/.env) and fill in real values.
# python-dotenv loads it automatically on startup (main.py calls load_dotenv()).

# Groq keys: https://console.groq.com/keys
# Gemini and OpenRouter workspace content is blocked by default. Gemini requires an approved paid-tier policy opt-in;
# OpenRouter is kept to non-private general chat because downstream provider policies vary.

# Optional: defaults to a local SQLite file if not set.
# For Render / production, point this at a Postgres connection string instead,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./opa.db

# Local-only no-login development mode. The backend honors this only for
# requests arriving from this computer (loopback); keep it off in deployments.
# OPAI_LOCAL_AUTH_BYPASS=false

# Optional: force the resume/RAG embedder. auto (default) tries fastembed, falls
# back to a hashed embedder if that's unavailable. Set to "hash" to force the
# lightweight fallback, or "fastembed" to require the real model.
# RAG_EMBEDDER=auto

# Typed routing: Jev first -> Groq structured fallback -> deterministic fallback.
# Jev is provider-agnostic here because its exact production endpoint/contract
# must come from your TypeSafe account.
JEV_ENABLED=false
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_SECONDS=8

# Legacy internal Groq model roles for structured-output tasks.
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Never enable this in production.
ENABLE_DEV_SEED=false
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GENERAL_CHAT_PER_MIN=20

# Knowledge uploads (rag_api.py). Defaults shown.
# RAG_MAX_FILE_MB=10
# Minimum relevance for a passage to be used. Tune against your own documents:
# RAG_MIN_SCORE_FASTEMBED=0.30
# RAG_MIN_SCORE_HASH=0.12

# ---- Model picker (agent/model_catalog.py) ----
# Optional Hugging Face models (General mode only by default). Needs a HF token with Inference Providers access.
# HUGGINGFACE_API_KEY=
# JSON list; verify every model id on its Hugging Face page first, provider availability changes:
# KARNA_HF_MODELS=[{"key":"hf-llama-3-3-70b","label":"Llama 3.3 70B (Hugging Face)","model_id":"meta-llama/Llama-3.3-70B-Instruct"}]
# KARNA_GROQ_MODELS=[{"key":"groq-gpt-oss-20b","label":"GPT-OSS 20B (Groq)","model_id":"openai/gpt-oss-20b"}]
# Let Hugging Face models see Workspace data (documents, profile)? Off by default: it reaches third-party providers.
# KARNA_HF_WORKSPACE=off
# Per user per day, by cost tier. Defaults shown.
# KARNA_DAILY_CAPS=fast:300,balanced:150,deep:20,open:80
# HF_TIMEOUT=60

# ---- security gate (security_gate.py) ----
# On Render / OPAI_ENV=production the auth guard defaults to `enforce`; locally it stays `log`. Set explicitly to override.
# OPAI_AUTH_MODE=enforce
# OPAI_ENV=production
# The app refuses to boot in production if auth is off, OPAI_LOCAL_AUTH_BYPASS or ENABLE_DEV_SEED is on.
# Emergency only (logged loudly): OPAI_ALLOW_INSECURE_START=1

# ---- usage metering & plans (metering.py) ----
# off | log | enforce. Default: enforce in production, log elsewhere. Start with `log` for a few days to see real usage.
# OPAI_METERING=log
# Override plan caps (credits per day / month). Defaults: free 25/400, pro 250/5000, max 1000/20000.
# OPAI_PLAN_LIMITS={"free":{"day":25,"month":400},"pro":{"day":250,"month":5000,"price_inr":299}}
# Key for POST /v1/admin/plan (falls back to FEEDBACK_ADMIN_KEY)
# OPAI_ADMIN_KEY=

# ---- payments (billing_api.py, Cashfree) ----
# Leave unset to keep checkout off (plans can still be set by an admin).
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox            # sandbox | production
# OPAI_PUBLIC_URL=https://your-frontend.example
# OPAI_API_URL=https://your-api.example   # webhook URL becomes {OPAI_API_URL}/v1/billing/webhook

# ---- keep users' original uploads (OFF by default; update privacy.html BEFORE turning this on) ----
# OPAI_FILE_STORE=off          # off | local | r2
# OPAI_FILE_MAX_MB=10          # largest single file kept
# OPAI_FILE_QUOTA_MB={"free":50,"pro":1000,"max":5000}   # total stored per user, by plan
# OPAI_FILE_DIR=user_files     # local mode only (needs a persistent disk on Render)
# R2_ACCOUNT_ID=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=  R2_BUCKET=   # r2 mode (Cloudflare R2, S3 API)
