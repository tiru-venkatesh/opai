# Copy this file to ".env" in the same folder (backend/.env) and fill in real values.
# python-dotenv loads it automatically on startup (main.py calls load_dotenv()).

# Required for KARNA chat, Resume Lab scoring/"ask this resume", and study-plan text.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional: defaults to a local SQLite file if not set.
# For Render / production, point this at a Postgres connection string instead,
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./opa.db

# Optional: force the resume/RAG embedder. auto (default) tries fastembed, falls
# back to a hashed embedder if that's unavailable. Set to "hash" to force the
# lightweight fallback, or "fastembed" to require the real model.
# RAG_EMBEDDER=auto

# Typed routing: Jev first -> Groq structured fallback -> deterministic fallback.
# Jev is provider-agnostic here because its exact production endpoint/contract
# must come from your TypeSafe account.
JEV_ENABLED=false
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_SECONDS=8

# Groq model roles. The router uses a smaller structured-output model;
# KARNA tool calling can use the agent model.
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Never enable this in production.
ENABLE_DEV_SEED=false
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
