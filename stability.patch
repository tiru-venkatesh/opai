+++ nzw/backend/scripts/check_deploy.py	2026-10-11 20:33:01.384951238 +0000
@@ -0,0 +1,139 @@
+"""Post-deploy contract check. Standard library only.
+
+    python scripts/check_deploy.py https://opa-52ug.onrender.com --origin https://www.opai.live
+
+Exit code 1 if anything FAILs (WARN and SKIP do not fail). Run it right after a deploy, from your laptop or CI.
+It only sends harmless requests: GETs, one CORS preflight, and one POST to a Gmail-send URL for an outbox id that cannot exist.
+
+What it checks, and what it deliberately does not:
+  wake      /v1/health answers (waits up to --wait seconds for a sleeping free-tier backend, and reports how long it took)
+  health    /v1/system/health and /v1/system/scheduler-status answer with JSON
+  version   /v1/version exists and its api_contract >= the one in frontend/build.json (run scripts/stamp_build.py first)
+  routes    every /v1 path the frontend calls is in the deployed /openapi.json  (this is the stale-deploy detector)
+  cors      a preflight from --origin is allowed
+  identity  an identity-less call is refused (this app identifies users by user_id, not tokens: there is no 401 to expect)
+  gmail     the send endpoint answers an unknown outbox id with a clean 4xx JSON error, not a 5xx crash
+  tick      only if /v1/system/tick exists: it must reject a request without the secret (SKIP when the route does not exist)
+"""
+import argparse, json, os, re, sys, time, urllib.error, urllib.request
+
+HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
+import route_contract as RC  # noqa: E402
+
+RESULTS = []
+
+
+def rec(status, name, detail=""):
+    RESULTS.append(status)
+    print(f"{status:5} {name}" + (f"  - {detail}" if detail else ""))
+
+
+def call(method, url, body=None, headers=None, timeout=20):
+    req = urllib.request.Request(url, method=method, data=(json.dumps(body).encode() if body is not None else None),
+                                 headers={"Content-Type": "application/json", **(headers or {})})
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            raw = r.read().decode("utf-8", "replace")
+            return r.status, raw, dict(r.headers)
+    except urllib.error.HTTPError as e:
+        return e.code, e.read().decode("utf-8", "replace"), dict(e.headers)
+    except Exception as e:  # noqa: BLE001
+        return 0, str(e), {}
+
+
+def js(raw):
+    try:
+        return json.loads(raw)
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("base"); ap.add_argument("--origin", default=None); ap.add_argument("--wait", type=int, default=90)
+    a = ap.parse_args(); base = a.base.rstrip("/")
+
+    t0 = time.time(); code = 0
+    while time.time() - t0 < a.wait:
+        code, _, _ = call("GET", base + "/v1/health", timeout=15)
+        if code == 200:
+            break
+        time.sleep(3)
+    secs = round(time.time() - t0, 1)
+    if code != 200:
+        rec("FAIL", "wake", f"/v1/health gave {code or 'no answer'} after {secs}s"); return 1
+    rec("PASS", "wake", f"backend answered after {secs}s" + (" (it was asleep)" if secs > 5 else ""))
+
+    c, raw, _ = call("GET", base + "/v1/system/health"); d = js(raw)
+    rec("PASS" if c == 200 and isinstance(d, dict) else "FAIL", "health /v1/system/health", f"{c}" + (f" keys={sorted(d)[:8]}" if isinstance(d, dict) else ""))
+    c, raw, _ = call("GET", base + "/v1/system/scheduler-status"); d = js(raw)
+    rec("PASS" if c == 200 and isinstance(d, dict) else "FAIL", "scheduler /v1/system/scheduler-status", f"{c}")
+
+    build = None
+    try:
+        build = json.load(open(os.path.join(RC.FRONT, "build.json")))
+    except Exception:  # noqa: BLE001
+        pass
+    c, raw, _ = call("GET", base + "/v1/version"); d = js(raw)
+    if c != 200 or not isinstance(d, dict):
+        rec("FAIL", "version /v1/version", f"{c}: the deployed backend predates the version endpoint (stale deploy)")
+    elif build is None:
+        rec("WARN", "version", f"backend contract {d.get('api_contract')}; no frontend/build.json to compare (run scripts/stamp_build.py)")
+    elif d.get("api_contract", 0) < build["api_contract"]:
+        rec("FAIL", "version", f"backend contract {d.get('api_contract')} < frontend {build['api_contract']}: deploy the backend")
+    else:
+        rec("PASS", "version", f"backend contract {d.get('api_contract')} >= frontend {build['api_contract']}, sha {d.get('git_sha')}")
+
+    c, raw, _ = call("GET", base + "/openapi.json"); spec = js(raw)
+    deployed = None
+    if c == 200 and isinstance(spec, dict) and "paths" in spec:
+        deployed = list(spec["paths"].keys())
+        norm = [re.sub(r"\{[^}]+\}", "{x}", p) for p in deployed]
+        pats = [re.compile("^" + re.escape(n).replace(re.escape("{x}"), "[^/]+") + "/?$") for n in norm]
+        missing = []
+        for page, paths in RC.frontend_paths().items():
+            for p in sorted(paths):
+                ok = any(n.startswith(p) for n in norm) if (p.endswith("/") or p.endswith("{x}")) else any(rx.match(p) for rx in pats)
+                if not ok:
+                    missing.append(f"{page}: {p}")
+        if missing:
+            rec("FAIL", "routes", f"{len(missing)} frontend path(s) not served by the deployed backend (version mismatch):")
+            for m in missing[:25]:
+                print("        " + m)
+        else:
+            rec("PASS", "routes", f"all frontend /v1 paths are served ({len(deployed)} deployed paths)")
+    else:
+        rec("WARN", "routes", f"/openapi.json not available ({c}); cannot compare routes")
+
+    if a.origin:
+        c, _, h = call("OPTIONS", base + "/v1/health", headers={"Origin": a.origin, "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type"})
+        allow = {k.lower(): v for k, v in h.items()}.get("access-control-allow-origin")
+        if c in (200, 204) and allow in (a.origin, "*"):
+            rec("PASS" if allow == a.origin else "WARN", "cors", f"allows {a.origin}" + (" via '*' (set CORS_ORIGINS to lock it down)" if allow == "*" else ""))
+        else:
+            rec("FAIL", "cors", f"preflight from {a.origin} -> {c}, Access-Control-Allow-Origin={allow}")
+    else:
+        rec("SKIP", "cors", "pass --origin https://your-frontend to check it")
+
+    c, _, _ = call("GET", base + "/v1/opp/profile")
+    rec("PASS" if c in (401, 403, 422) else "FAIL", "identity", f"/v1/opp/profile without user_id -> {c} (expected 401/403/422)")
+    c, _, _ = call("POST", base + "/v1/auth/guest")
+    rec("PASS" if c in (404, 405) else "FAIL", "no guest login", f"/v1/auth/guest -> {c}")
+
+    c, raw, h = call("POST", base + "/v1/opp/outbox/does-not-exist/send", body={"user_id": "check-deploy"}, headers={"X-Gmail-Token": ""})
+    d = js(raw)
+    rec("PASS" if 400 <= c < 500 and isinstance(d, dict) and "detail" in d else "FAIL", "gmail send error handling", f"unknown outbox id -> {c}" + ("" if isinstance(d, dict) else " (not a JSON error)"))
+
+    if deployed and "/v1/system/tick" in deployed:
+        c, _, _ = call("POST", base + "/v1/system/tick")
+        rec("PASS" if c in (401, 403, 422) else "FAIL", "tick requires secret", f"POST /v1/system/tick without secret -> {c}")
+    else:
+        rec("SKIP", "tick", "no /v1/system/tick route in this backend")
+
+    fails = RESULTS.count("FAIL")
+    print(f"\n{RESULTS.count('PASS')} passed, {RESULTS.count('WARN')} warning(s), {fails} failed, {RESULTS.count('SKIP')} skipped")
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN -x __pycache__ -x .git -x .pytest_cache -x '*.pyc' pristine/backend/scripts/route_contract.py nzw/backend/scripts/route_contract.py
--- pristine/backend/scripts/route_contract.py	1970-01-01 00:00:00.000000000 +0000
+++ nzw/backend/scripts/route_contract.py	2026-10-11 20:33:25.395243547 +0000
@@ -0,0 +1,152 @@
+"""Static route contract: every /v1/... path the frontend calls must be served by the backend.
+
+Needs only the standard library (no FastAPI, no database), so it runs in CI before anything is installed and
+against a checkout that cannot be imported. It reads routes from the Python source (APIRouter prefixes,
+@router.get/post/..., include_router prefixes) and compares them with the paths in frontend/*.html and *.js.
+
+    python scripts/route_contract.py            # exit 1 if any page calls a route the backend lacks
+    python scripts/route_contract.py --list     # print the backend route table (only routers main.py registers)
+
+Limits (stated so nobody trusts it too much): it checks PATHS, not HTTP methods or response shapes, and a path built
+from several runtime pieces is only checked as far as its literal parts. tests/test_frontend_contract.py (OpenAPI,
+needs FastAPI) remains the authoritative check where it can run.
+"""
+from __future__ import annotations
+
+import ast
+import os
+import re
+import sys
+from typing import Dict, List, Set, Tuple
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+BACK = os.path.dirname(HERE)
+FRONT = os.path.join(os.path.dirname(BACK), "frontend")
+VERBS = {"get", "post", "put", "patch", "delete"}
+
+
+def _const(node) -> str | None:
+    return node.value if isinstance(node, ast.Constant) and isinstance(node.value, str) else None
+
+
+def backend_routes() -> List[Tuple[str, str, str]]:
+    """[(METHOD, path, source_file)] including router prefixes and include_router prefixes."""
+    mods: Dict[str, Dict] = {}
+    for fn in sorted(os.listdir(BACK)):
+        if not fn.endswith(".py"):
+            continue
+        tree = ast.parse(open(os.path.join(BACK, fn), encoding="utf-8").read())
+        prefixes: Dict[str, str] = {}
+        routes: List[Tuple[str, str, str]] = []
+        for n in ast.walk(tree):
+            if isinstance(n, ast.Assign) and isinstance(n.value, ast.Call) and getattr(n.value.func, "id", "") in ("APIRouter", "FastAPI"):
+                pre = next((_const(k.value) for k in n.value.keywords if k.arg == "prefix"), "") or ""
+                for t in n.targets:
+                    if isinstance(t, ast.Name):
+                        prefixes[t.id] = pre
+        for n in ast.walk(tree):
+            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                for d in n.decorator_list:
+                    if isinstance(d, ast.Call) and isinstance(d.func, ast.Attribute) and d.func.attr in VERBS and isinstance(d.func.value, ast.Name) and d.args:
+                        p = _const(d.args[0])
+                        if p is not None:
+                            routes.append((d.func.attr.upper(), prefixes.get(d.func.value.id, "") + p, fn))
+        mods[fn[:-3]] = {"routes": routes}
+        mods[fn[:-3]]["tree"] = tree
+    # include_router(alias, prefix=...) in any module; alias resolved through "from mod import router as alias"
+    extra: Dict[str, List[str]] = {}
+    for name, m in mods.items():
+        alias_to_mod: Dict[str, str] = {}
+        for n in ast.walk(m["tree"]):
+            if isinstance(n, ast.ImportFrom) and n.module:
+                for a in n.names:
+                    alias_to_mod[a.asname or a.name] = n.module.split(".")[-1]
+        for n in ast.walk(m["tree"]):
+            if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == "include_router" and n.args and isinstance(n.args[0], ast.Name):
+                pre = next((_const(k.value) for k in n.keywords if k.arg == "prefix"), "") or ""
+                target = alias_to_mod.get(n.args[0].id)
+                if target in mods:
+                    extra.setdefault(target, []).append(pre)
+    out = []
+    for name, m in mods.items():
+        # A router that no module registers with include_router serves NOTHING, however many routes its file defines.
+        # (main.py's own @app routes are always served.)
+        if name != "main" and name not in extra:
+            continue
+        for meth, p, fn in m["routes"]:
+            for pre in (extra.get(name) or [""]):
+                out.append((meth, pre + p, fn))
+    return out
+
+
+def unregistered_routers() -> List[Tuple[str, int]]:
+    """Modules that define routes but are never included by main.py: [(module_file, route_count)]."""
+    counted = {fn for _, _, fn in backend_routes()}
+    res = []
+    for fn in sorted(os.listdir(BACK)):
+        if not fn.endswith(".py") or fn in counted:
+            continue
+        tree = ast.parse(open(os.path.join(BACK, fn), encoding="utf-8").read())
+        n = sum(1 for x in ast.walk(tree) if isinstance(x, (ast.FunctionDef, ast.AsyncFunctionDef)) for d in x.decorator_list
+                if isinstance(d, ast.Call) and isinstance(d.func, ast.Attribute) and d.func.attr in VERBS and d.args and _const(d.args[0]) is not None)
+        if n:
+            res.append((fn, n))
+    return res
+
+
+_LIT = re.compile(r"""(['"`])(/v1/[^'"`\s]*)\1""")
+_CONCAT = re.compile(r"""(['"])(/v1/[^'"\s]*)\1\s*\+\s*[^+'"]+?\s*\+\s*(['"])(/[^'"\s]*)\3""")
+_TPL = re.compile(r"`(/v1/[^`\s]*)`")
+
+
+def frontend_paths() -> Dict[str, Set[str]]:
+    found: Dict[str, Set[str]] = {}
+    for fn in sorted(os.listdir(FRONT)):
+        if not fn.endswith((".html", ".js")) or fn == "sw.js":
+            continue
+        src = open(os.path.join(FRONT, fn), encoding="utf-8", errors="ignore").read()
+        paths: Set[str] = set()
+        for m in _CONCAT.finditer(src):
+            paths.add((m.group(2) + "{x}" + m.group(4)).split("?")[0])
+        for m in _TPL.finditer(src):
+            paths.add(re.sub(r"\$\{[^}]*\}", "{x}", m.group(1)).split("?")[0])
+        for m in _LIT.finditer(src):
+            p = m.group(2).split("?")[0]
+            if "${" in p:
+                p = re.sub(r"\$\{[^}]*\}", "{x}", p)
+            paths.add(p)
+        if paths:
+            found[fn] = paths
+    return found
+
+
+def check() -> List[str]:
+    routes = backend_routes()
+    norm = [re.sub(r"\{[^}]+\}", "{x}", p) for _, p, _ in routes]          # /v1/actions/{action_id}/approve -> /v1/actions/{x}/approve
+    pats = [re.compile("^" + re.escape(n).replace(re.escape("{x}"), "[^/]+") + "/?$") for n in norm]
+    missing = []
+    for page, paths in frontend_paths().items():
+        for p in sorted(paths):
+            if p.endswith("/") or p.endswith("{x}"):   # the rest of the path is built at runtime (e.g. '/v1/actions/'+id+'/'+verb)
+                ok = any(n.startswith(p) or n.startswith(p[:-3] if p.endswith("{x}") else p) for n in norm)
+            else:
+                ok = any(rx.match(p) for rx in pats)
+            if not ok:
+                missing.append(f"{page}: {p}")
+    return missing
+
+
+if __name__ == "__main__":
+    if "--list" in sys.argv:
+        for meth, p, fn in sorted(backend_routes(), key=lambda r: (r[1], r[0])):
+            print(f"{meth:6} {p}   ({fn})")
+        sys.exit(0)
+    miss = check()
+    n_routes = len(backend_routes())
+    for fn, n in unregistered_routers():
+        print(f"NOTE: {fn} defines {n} route(s) but main.py never registers it, so they are NOT served.")
+    if miss:
+        print(f"{len(miss)} frontend path(s) have no backend route ({n_routes} routes read):")
+        print("\n".join("  " + m for m in miss))
+        sys.exit(1)
+    print(f"OK: every /v1 path in the frontend is served ({n_routes} backend routes read).")
diff -ruN -x __pycache__ -x .git -x .pytest_cache -x '*.pyc' pristine/backend/scripts/stamp_build.py nzw/backend/scripts/stamp_build.py
--- pristine/backend/scripts/stamp_build.py	1970-01-01 00:00:00.000000000 +0000
+++ nzw/backend/scripts/stamp_build.py	2026-10-11 20:33:01.385254536 +0000
@@ -0,0 +1,16 @@
+"""Writes frontend/build.json: the API contract number this frontend was built against.
+Run it as part of the frontend deploy:   python backend/scripts/stamp_build.py
+opai-conn.js reads build.json and GET /v1/version; if the backend's number is lower, users see "OPAI is updating"."""
+import json, os, re, subprocess
+from datetime import datetime, timezone
+HERE = os.path.dirname(os.path.abspath(__file__)); BACK = os.path.dirname(HERE); FRONT = os.path.join(os.path.dirname(BACK), "frontend")
+src = open(os.path.join(BACK, "version_api.py"), encoding="utf-8").read()
+contract = int(re.search(r"^API_CONTRACT\s*=\s*(\d+)", src, re.M).group(1))
+try:
+    sha = subprocess.run(["git", "rev-parse", "--short=12", "HEAD"], cwd=BACK, capture_output=True, text=True, timeout=5).stdout.strip() or None
+except Exception:
+    sha = None
+out = {"api_contract": contract, "git_sha": sha, "built_at": datetime.now(timezone.utc).isoformat(timespec="seconds")}
+with open(os.path.join(FRONT, "build.json"), "w", encoding="utf-8") as f:
+    json.dump(out, f, indent=1)
+print("wrote frontend/build.json", out)
