+def test_stale_send_claim_can_be_released_but_a_live_one_cannot(c, uid, monkeypatch):
+    """A restart between 'claim' and 'Gmail call' used to leave the item on 'sending' forever."""
+    import time as _t
+    import gmail_send
+    from database import OutboxItem, SessionLocal
+    calls = []
+    monkeypatch.setattr(gmail_send, "send", lambda tok, to, sub, body, frm=None: calls.append(to) or "gm-9")
+    prof, oid = _approved(c, uid, "stale@iitx.ac.in")
+    body = {"user_id": uid}
+    with SessionLocal() as db:                       # a claim made just now: still running
+        db.query(OutboxItem).filter(OutboxItem.id == oid).update({"sent_via": f"gmail_api:sending:{int(_t.time())}"})
+        db.commit()
+    assert c.post(f"/v1/opp/outbox/{oid}/send", json=body, headers={"X-Gmail-Token": "t"}).status_code == 409
+    assert c.post(f"/v1/opp/outbox/{oid}/send/release", json=body).status_code == 409        # too fresh to release
+    with SessionLocal() as db:                       # the same claim, 10 minutes old: left by a dead server
+        db.query(OutboxItem).filter(OutboxItem.id == oid).update({"sent_via": f"gmail_api:sending:{int(_t.time()) - 600}"})
+        db.commit()
+    r = c.post(f"/v1/opp/outbox/{oid}/send", json=body, headers={"X-Gmail-Token": "t"})
+    assert r.status_code == 409 and "did not finish" in r.json()["detail"] and calls == []     # never auto-resends (could duplicate)
+    assert c.post(f"/v1/opp/outbox/{oid}/send/release", json=body).json()["released"] is True
+    assert c.post(f"/v1/opp/outbox/{oid}/send", json=body, headers={"X-Gmail-Token": "t"}).status_code == 200
+    assert calls == ["stale@iitx.ac.in"]
+    assert c.post(f"/v1/opp/outbox/{oid}/send/release", json=body).status_code == 409        # already sent: nothing to release
