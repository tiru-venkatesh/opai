POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: without it, /v1/ask returns extractive (cited) answers instead of written ones.
ANTHROPIC_API_KEY=
# Where the free Lite package comes from until it is on PyPI, e.g. git+https://github.com/YOU/opai-rag-starter-lite
LITE_SPEC=opai-rag-starter-lite
WITH_EMBEDDINGS=1
OPAI_RAG_RATE_PER_MIN=60
OPAI_RAG_DAILY_ASKS=500
